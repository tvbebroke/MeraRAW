{
  "name": "meratech-editor",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "import-presets": "node scripts/import-lightroom-presets.mjs",
    "tag-presets": "node scripts/tag-presets.mjs",
    "release": "bash scripts/release-beta.sh",
    "notarize": "bash scripts/notarize-dmg.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "nanostores": "^1.0.1",
    "posthog-js": "^1.405.2",
    "svelte-spa-router": "^5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3",
    "vite": "^6",
    "vitest": "^4.1.10"
  }
}
