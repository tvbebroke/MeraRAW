# Supabase (same project as meratech.co — optional override; defaults are baked into release builds)
VITE_SUPABASE_URL=https://kaanlfnxoyrjrgqrxcuz.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional
VITE_PURCHASE_URL=https://www.meratech.co/#download
VITE_EARLY_SUPPORTER_URL=https://www.meratech.co/early-supporter.html

# Dev only — skip license gate (ignored in release / packaged builds)
# MERARAW_SKIP_LICENSE=1

# Release / notarization (scripts/release-beta.sh, scripts/notarize-dmg.sh)
# APPLE_ID=you@example.com
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=ZJP5CXC3FS
# NOTARY_KEYCHAIN_PROFILE=meraraw-notary

# R2 private download bucket (see docs/LICENSING.md)
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=meraraw-releases
# R2_OBJECT_KEY=MeraRAW Beta 0.1.1.dmg
